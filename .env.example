# Copy to .env and adjust. .env in this repository only holds non-secret defaults,
# so it is committed; put real secrets in .env.local (gitignored) or inject them
# from the deployment environment.

# Bind address of the Rust server.
#   127.0.0.1 -> local only
#   0.0.0.0   -> reachable from outside (containers, VMs)
HOST=127.0.0.1

# Port of the Rust server. Also the production HTTP port.
PORT=8080

# Port of the Vite dev server. Only used by `bun run dev`.
WEB_PORT=5173

# tracing filter. "<level>,<target>=<level>".
RUST_LOG=info,zhizhi_server=debug,tower_http=info

# SQLite 数据库位置；相对路径基于启动时的工作目录。
DATABASE_URL=sqlite://zhizhi.db

# JWT 签名密钥。开发默认值仅够本机调试，生产环境必须覆盖（建议 32 字节以上随机串）。
JWT_SECRET=please-change-me-to-a-long-random-string
